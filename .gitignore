/target/
**/*.rs.bk
.DS_Store

# Project-local Kara state is never committed automatically.
.kara/sessions/
.kara/cache/

# VS Code extension build output
extensions/vscode/node_modules/
extensions/vscode/out/
extensions/vscode/*.vsix
extensions/vscode/.vscode-test/

# Eval runs
tests/evals/results/*.json
!tests/evals/results/.gitkeep

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/

# Release packaging output
/dist/
/packaging-out/

# Desktop app: CLI copied in at build time (see binaries/README.md)
apps/desktop/src-tauri/binaries/kara
apps/desktop/src-tauri/binaries/kara.exe
