{
  "name": "veyra",
  "displayName": "Veyra: Local AI Engineering Agent",
  "description": "A free, open-source AI engineering agent that runs on your machine. No account, no subscription, no code uploads.",
  "version": "0.1.0",
  "publisher": "iamzayn19",
  "author": "iamzayn19",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/iamzayn19/veyra"
  },
  "homepage": "https://github.com/iamzayn19/veyra",
  "bugs": {
    "url": "https://github.com/iamzayn19/veyra/issues"
  },
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Machine Learning",
    "Other"
  ],
  "keywords": [
    "ai",
    "agent",
    "local",
    "llm",
    "offline",
    "llama.cpp",
    "code review"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "veyra",
          "title": "Veyra",
          "icon": "media/veyra.svg"
        }
      ]
    },
    "views": {
      "veyra": [
        {
          "type": "webview",
          "id": "veyra.chat",
          "name": "Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "veyra.open",
        "title": "Veyra: Open",
        "category": "Veyra"
      },
      {
        "command": "veyra.newSession",
        "title": "Veyra: New Session",
        "category": "Veyra"
      },
      {
        "command": "veyra.askAboutSelection",
        "title": "Veyra: Ask About Selection",
        "category": "Veyra"
      },
      {
        "command": "veyra.fixSelection",
        "title": "Veyra: Fix Selection",
        "category": "Veyra"
      },
      {
        "command": "veyra.reviewDiff",
        "title": "Veyra: Review Current Diff",
        "category": "Veyra"
      },
      {
        "command": "veyra.runTests",
        "title": "Veyra: Run Tests",
        "category": "Veyra"
      },
      {
        "command": "veyra.chooseModel",
        "title": "Veyra: Choose Model",
        "category": "Veyra"
      },
      {
        "command": "veyra.doctor",
        "title": "Veyra: Doctor",
        "category": "Veyra"
      },
      {
        "command": "veyra.showChanges",
        "title": "Veyra: Show Changes",
        "category": "Veyra"
      },
      {
        "command": "veyra.undo",
        "title": "Veyra: Undo Last Change Batch",
        "category": "Veyra"
      },
      {
        "command": "veyra.stop",
        "title": "Veyra: Stop Current Task",
        "category": "Veyra"
      },
      {
        "command": "veyra.restart",
        "title": "Veyra: Restart Agent",
        "category": "Veyra"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "veyra.askAboutSelection",
          "when": "editorHasSelection",
          "group": "veyra@1"
        },
        {
          "command": "veyra.fixSelection",
          "when": "editorHasSelection",
          "group": "veyra@2"
        }
      ]
    },
    "configuration": {
      "title": "Veyra",
      "properties": {
        "veyra.binaryPath": {
          "type": "string",
          "default": "",
          "description": "Path to the veyra binary. Empty: search PATH, then the copy managed by this extension."
        },
        "veyra.permissionProfile": {
          "type": "string",
          "enum": [
            "",
            "safe",
            "balanced",
            "autonomous"
          ],
          "default": "",
          "description": "Permission profile for editor sessions. Empty uses ~/.veyra/config.toml."
        },
        "veyra.includeDiagnostics": {
          "type": "boolean",
          "default": true,
          "description": "Send the current file's diagnostics with selection commands."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "test": "npm run compile && node --test \"out/test/*.test.js\"",
    "package": "vsce package --no-dependencies",
    "vscode:prepublish": "npm run compile",
    "test:host": "npm run compile && node out/test/runHost.js"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.2.0",
    "typescript": "^5.6.0",
    "@vscode/test-electron": "^2.4.1"
  }
}
