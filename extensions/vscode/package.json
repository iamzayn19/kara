{
  "name": "kara",
  "displayName": "Kara",
  "description": "Local-first coding agent. Chat, edits, tests and reviews in VS Code, driven by the Kara binary on your machine.",
  "version": "0.1.0",
  "publisher": "iamzayn19",
  "author": "iamzayn19",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/iamzayn19/kara"
  },
  "homepage": "https://github.com/iamzayn19/kara",
  "bugs": {
    "url": "https://github.com/iamzayn19/kara/issues"
  },
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "coding agent",
    "local",
    "offline",
    "code review",
    "refactoring",
    "tests"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "kara",
          "title": "Kara",
          "icon": "media/kara.svg"
        }
      ]
    },
    "views": {
      "kara": [
        {
          "type": "webview",
          "id": "kara.chat",
          "name": "Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "kara.open",
        "title": "Kara: Open",
        "category": "Kara"
      },
      {
        "command": "kara.newSession",
        "title": "Kara: New Session",
        "category": "Kara"
      },
      {
        "command": "kara.askAboutSelection",
        "title": "Kara: Ask About Selection",
        "category": "Kara"
      },
      {
        "command": "kara.fixSelection",
        "title": "Kara: Fix Selection",
        "category": "Kara"
      },
      {
        "command": "kara.reviewDiff",
        "title": "Kara: Review Current Diff",
        "category": "Kara"
      },
      {
        "command": "kara.runTests",
        "title": "Kara: Run Tests",
        "category": "Kara"
      },
      {
        "command": "kara.chooseModel",
        "title": "Kara: Choose Model",
        "category": "Kara"
      },
      {
        "command": "kara.connect",
        "title": "Kara: Connect to Inference Machine",
        "category": "Kara"
      },
      {
        "command": "kara.doctor",
        "title": "Kara: Doctor",
        "category": "Kara"
      },
      {
        "command": "kara.showChanges",
        "title": "Kara: Show Changes",
        "category": "Kara"
      },
      {
        "command": "kara.undo",
        "title": "Kara: Undo Last Change Batch",
        "category": "Kara"
      },
      {
        "command": "kara.stop",
        "title": "Kara: Stop Current Task",
        "category": "Kara"
      },
      {
        "command": "kara.restart",
        "title": "Kara: Restart Agent",
        "category": "Kara"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "kara.askAboutSelection",
          "when": "editorHasSelection",
          "group": "kara@1"
        },
        {
          "command": "kara.fixSelection",
          "when": "editorHasSelection",
          "group": "kara@2"
        }
      ]
    },
    "configuration": {
      "title": "Kara",
      "properties": {
        "kara.permissions.mode": {
          "type": "string",
          "enum": [
            "",
            "ask",
            "workspace",
            "full"
          ],
          "default": "",
          "scope": "application",
          "enumDescriptions": [
            "Use your Kara user configuration (`kara config get permissions.mode`).",
            "Ask before edits and shell commands.",
            "Edit, test and build inside the workspace freely; ask for risky actions.",
            "Broad tool execution without asking; high-risk boundaries still ask."
          ],
          "markdownDescription": "Permission mode for editor sessions. User setting only: workspace settings cannot change it. Empty uses your Kara user configuration."
        },
        "kara.inference.provider": {
          "type": "string",
          "enum": [
            "",
            "local",
            "kara",
            "openai_compat",
            "ollama",
            "lmstudio",
            "vllm"
          ],
          "default": "",
          "scope": "application",
          "markdownDescription": "Where inference runs for editor sessions. Empty uses your Kara user configuration. Endpoints and tokens are configured with `kara config` / `kara connect`."
        },
        "kara.model": {
          "type": "string",
          "default": "",
          "scope": "application",
          "markdownDescription": "Model for editor sessions: a local model id (see `kara models`), `auto`, or the model name an endpoint serves. Empty uses your Kara user configuration. Choosing a model never downloads anything without confirmation."
        },
        "kara.binary.path": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Path to the `kara` binary. Empty: use `kara` on PATH, then the copy managed in Kara's data directory. Machine setting only."
        },
        "kara.autoStart": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "markdownDescription": "Start Kara when a folder opens. When off, Kara starts the first time you use it."
        },
        "kara.includeDiagnostics": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Send the current file's diagnostics with selection commands."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "test": "npm run compile && node --test \"out/test/*.test.js\"",
    "package": "vsce package --no-dependencies",
    "vscode:prepublish": "npm run compile",
    "test:host": "npm run compile && node out/test/runHost.js"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.2.0",
    "typescript": "^5.6.0",
    "@vscode/test-electron": "^2.4.1"
  }
}
