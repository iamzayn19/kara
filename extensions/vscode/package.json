{
  "name": "kara",
  "displayName": "Kara: Local AI Engineering Agent",
  "description": "A free, open-source AI engineering agent that runs on your machine. No account, no subscription, no code uploads.",
  "version": "0.1.0",
  "publisher": "iamzayn19",
  "author": "iamzayn19",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/iamzayn19/kara"
  },
  "homepage": "https://github.com/iamzayn19/kara",
  "bugs": {
    "url": "https://github.com/iamzayn19/kara/issues"
  },
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Machine Learning",
    "Other"
  ],
  "keywords": [
    "ai",
    "agent",
    "local",
    "llm",
    "offline",
    "llama.cpp",
    "code review"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "kara",
          "title": "Kara",
          "icon": "media/kara.svg"
        }
      ]
    },
    "views": {
      "kara": [
        {
          "type": "webview",
          "id": "kara.chat",
          "name": "Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "kara.open",
        "title": "Kara: Open",
        "category": "Kara"
      },
      {
        "command": "kara.newSession",
        "title": "Kara: New Session",
        "category": "Kara"
      },
      {
        "command": "kara.askAboutSelection",
        "title": "Kara: Ask About Selection",
        "category": "Kara"
      },
      {
        "command": "kara.fixSelection",
        "title": "Kara: Fix Selection",
        "category": "Kara"
      },
      {
        "command": "kara.reviewDiff",
        "title": "Kara: Review Current Diff",
        "category": "Kara"
      },
      {
        "command": "kara.runTests",
        "title": "Kara: Run Tests",
        "category": "Kara"
      },
      {
        "command": "kara.chooseModel",
        "title": "Kara: Choose Model",
        "category": "Kara"
      },
      {
        "command": "kara.doctor",
        "title": "Kara: Doctor",
        "category": "Kara"
      },
      {
        "command": "kara.showChanges",
        "title": "Kara: Show Changes",
        "category": "Kara"
      },
      {
        "command": "kara.undo",
        "title": "Kara: Undo Last Change Batch",
        "category": "Kara"
      },
      {
        "command": "kara.stop",
        "title": "Kara: Stop Current Task",
        "category": "Kara"
      },
      {
        "command": "kara.restart",
        "title": "Kara: Restart Agent",
        "category": "Kara"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "kara.askAboutSelection",
          "when": "editorHasSelection",
          "group": "kara@1"
        },
        {
          "command": "kara.fixSelection",
          "when": "editorHasSelection",
          "group": "kara@2"
        }
      ]
    },
    "configuration": {
      "title": "Kara",
      "properties": {
        "kara.binaryPath": {
          "type": "string",
          "default": "",
          "description": "Path to the kara binary. Empty: search PATH, then the copy managed by this extension."
        },
        "kara.permissionProfile": {
          "type": "string",
          "enum": [
            "",
            "safe",
            "balanced",
            "autonomous"
          ],
          "default": "",
          "description": "Permission mode for editor sessions. Empty uses your Kara user configuration."
        },
        "kara.includeDiagnostics": {
          "type": "boolean",
          "default": true,
          "description": "Send the current file's diagnostics with selection commands."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "test": "npm run compile && node --test \"out/test/*.test.js\"",
    "package": "vsce package --no-dependencies",
    "vscode:prepublish": "npm run compile",
    "test:host": "npm run compile && node out/test/runHost.js"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.2.0",
    "typescript": "^5.6.0",
    "@vscode/test-electron": "^2.4.1"
  }
}
